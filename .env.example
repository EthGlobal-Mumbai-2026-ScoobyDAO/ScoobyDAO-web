# Browser client uses the same-origin proxy. Set the upstream to your backend /web/v1 URL.
NEXT_PUBLIC_BACKEND_API_URL=https://scoobydao-backend.onrender.com/web/v1
NEXT_PUBLIC_API_URL=/api/backend

# Chain mode: live (default) uses the deployed contracts; fixture is the in-memory demo chain
# (opt-in, a banner shows on every page). These two values alone choose the chain protocol.
NEXT_PUBLIC_CHAIN_MODE=live
# Contracts in live mode: v2 (default, the deployed demo from the ../v2 handoff bundle) or v1.
NEXT_PUBLIC_PROTOCOL=v2
# Fixture backend data (cases, approvals). Opt-in only; an unreachable backend never turns it on.
NEXT_PUBLIC_USE_FIXTURES=false

# Dedicated RPC URLs are strongly recommended: public RPCs cap eth_getLogs ranges (viem's default
# Sepolia RPC allows 1,000 blocks per request). These ship to the browser, so use read-only keys
# restricted to your domain.
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ARB_SEPOLIA_RPC_URL=
# Chainlink CCIP message API (status of cross-chain stakes); the tracker falls back to the explorer link.
NEXT_PUBLIC_CCIP_API=https://api.ccip.chain.link
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional, operator-run faucet for demo dUSD. DemoUSD minting is role-gated: there is no public mint.
NEXT_PUBLIC_FAUCET_URL=
# /operator: role-gated demo actions (propose, adjudicate, simulated yield, claim fee) via the connected wallet.
NEXT_PUBLIC_OPERATOR_VIEW=false
# LP add/remove/claim panel. Defaults to true for V2 when unset.
NEXT_PUBLIC_LP_ENABLED=true
# V1 only: World ID reputation badge (Reputation.claimWinnerREP). Not the V2 REP stake receipt.
NEXT_PUBLIC_REPUTATION_BADGE_ENABLED=false

CONTRACTS_REPO_PATH=../SmartContracts      # used only by npm run sync:contracts (V1)
CONTRACTS_V2_HANDOFF=../v2                 # used only by npm run sync:v2
BACKEND_REPO_PATH=../ScoobyDAO-backend     # used only by type/fixture generation scripts

# Optional trusted HTTPS research API origin for /reports (HTTP only for localhost); blank leaves the library empty.
NEXT_PUBLIC_REPORT_API_URL=

# Local scouting and research API origins (backend root, not /web/v1).
NEXT_PUBLIC_SCOUTING_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_REPORT_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SYNTHETIC_JOURNEY=false
