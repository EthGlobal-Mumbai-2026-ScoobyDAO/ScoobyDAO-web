# Browser-visible, build-time settings: never put backend secrets in NEXT_PUBLIC_*.
# This example assumes the combined backend is listening on 127.0.0.1:8000.
# The legacy API uses /web/v1; research and scouting use the origin only.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/web/v1
NEXT_PUBLIC_REPORT_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SCOUTING_API_URL=http://127.0.0.1:8000

# Fixture approvals are opt-in; keep false for the real service.
NEXT_PUBLIC_USE_FIXTURES=false
NEXT_PUBLIC_PROTOCOL=v1

# Optional browser-visible values. Use public RPC endpoints or browser-safe keys only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ARB_SEPOLIA_RPC_URL=
NEXT_PUBLIC_FAUCET_URL=
NEXT_PUBLIC_REP_ENABLED=false
NEXT_PUBLIC_LP_ENABLED=false

# Local paths used by development sync/generation scripts, not browser credentials.
CONTRACTS_REPO_PATH=../SmartContracts
BACKEND_REPO_PATH=../ScoobyDAO-backend
